{
  "type": "column",
  "padding": 16,
  "spacing": 12,
  "children": [
    { "type": "text", "value": "RSS", "style": "headline" },
    { "type": "text", "style": "caption",
      "value": "Headlines are on the e-ink. Pick a layout, then tap Apply — it takes effect on the next paint." },
    { "type": "select", "local": "orientation", "label": "Layout",
      "default": "vertical",
      "options": [
        { "value": "vertical",   "label": "Columns (vertical rules)" },
        { "value": "horizontal", "label": "Rows (horizontal rules)" }
      ]
    },
    { "type": "button", "label": "Apply layout", "style": "primary",
      "action": {
        "type": "push",
        "payload": { "action": "set_layout", "value": "{{local.orientation}}" }
      }
    }
  ]
}
